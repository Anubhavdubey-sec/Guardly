# Guardly Configuration Template
# Copy this file to .env for local development.
# Never commit .env.

# Flask Security & Session
# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-secret
DEBUG=false
WTF_CSRF_ENABLED=true
SESSION_COOKIE_SECURE=false

# Multi-Device & Network Access
HOST=0.0.0.0
PORT=5000
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///database/users.db
AUTO_CREATE_SCHEMA=true

# SMTP Receiver Gateway Settings
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
MAX_MESSAGE_SIZE=10485760

# Outbound Mail Relay Configuration
RELAY_ENABLED=true
RELAY_HOST=127.0.0.1
RELAY_PORT=2526
RELAY_USE_TLS=false
RELAY_MOCK_MODE=true

# Gmail Workspace Post-Delivery Scanner
GMAIL_SERVICE_ACCOUNT_FILE=/path/to/google_service_account.json
GMAIL_DELEGATED_USER=admin@example.com
GMAIL_API_MOCK_MODE=true
GMAIL_REMEDIATION_ACTION=TRASH
GMAIL_RISK_THRESHOLD=65
