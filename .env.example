# Docker Compose reads a copied .env file automatically. For the Python app,
# set the same values in the shell that starts Flask.
# Use a long, random value for PHISHING_DETECTOR_SECRET_KEY outside local development.
MYSQL_DATABASE=phishguard
MYSQL_USER=phishguard
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CHARSET=utf8mb4
# The app uses the MYSQL_* fields above, so passwords do not need URL encoding.
# DATABASE_URL is only needed when using a hosted database instead.
# DATABASE_URL=mysql+pymysql://username:password@host:3306/phishguard?charset=utf8mb4
PHISHING_DETECTOR_SECRET_KEY=replace-with-a-long-random-secret
PHISHING_DETECTOR_AUTO_CREATE_SCHEMA=0
