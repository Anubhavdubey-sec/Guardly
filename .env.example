# PhishGuard Production Environment Configuration Template
# Copy this file to .env and set secure values for your deployment.
# NEVER store real secrets in this template file.

# Cryptographically secure secret key for session signing and CSRF protection.
# Generate a secret key in python using: secrets.token_hex(32)
SECRET_KEY=<GENERATE_WITH_PYTHON_SECRETS_TOKEN_HEX_32>

# Database Connection (SQLite default or MySQL connection URI)
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://<YOUR_DATABASE_USER>:<YOUR_DATABASE_PASSWORD>@127.0.0.1:3306/<YOUR_DATABASE_NAME>?charset=utf8mb4
DATABASE_URL=sqlite:///database/users.db

# Enable automatic database schema creation on startup
AUTO_CREATE_SCHEMA=True

# File Upload Configuration (Limit in bytes, default 10 MB)
MAX_CONTENT_LENGTH=10485760

# Public Threat Intelligence & Geo Context Settings
PUBLIC_LOOKUPS_ENABLED=True
PUBLIC_LOOKUP_TIMEOUT_SECONDS=3
PUBLIC_LOOKUP_MAX_LOOKUPS=5

# Debug Mode (MUST be False in production)
DEBUG=False

# Optional MySQL Settings (Docker / Enterprise MySQL)
MYSQL_DATABASE=<YOUR_DATABASE_NAME>
MYSQL_USER=<YOUR_DATABASE_USER>
MYSQL_PASSWORD=<YOUR_DATABASE_PASSWORD>
MYSQL_ROOT_PASSWORD=<YOUR_ROOT_DATABASE_PASSWORD>

