# Guardly Configuration Template (.env.example)

# Flask Security & Session
SECRET_KEY=change-in-production-token-hex
DEBUG=false
WTF_CSRF_ENABLED=true

# Database Configuration (MySQL / SQLite)
DATABASE_URL=sqlite:///database/users.db
AUTO_CREATE_SCHEMA=true

# SMTP Receiver Gateway Settings
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
MAX_MESSAGE_SIZE=10485760

# Outbound Mail Relay Configuration
RELAY_ENABLED=true
RELAY_HOST=127.0.0.1
RELAY_PORT=2526
RELAY_USE_TLS=false
RELAY_MOCK_MODE=true

# Gmail Workspace Post-Delivery Scanner Settings
GMAIL_SERVICE_ACCOUNT_FILE=/path/to/google_service_account.json
GMAIL_DELEGATED_USER=admin@company.com
GMAIL_API_MOCK_MODE=true
GMAIL_REMEDIATION_ACTION=TRASH
GMAIL_RISK_THRESHOLD=65
